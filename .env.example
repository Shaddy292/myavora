# Copy to .env for production deployments. All values are optional — the app
# runs with safe local defaults when they are absent.

# HTTP port and bind address for `npm start`.
# PORT=3000
# HOST=0.0.0.0

# Signs session cookies and API tokens. Leave unset to auto-generate
# .data/secret on first boot (fine for a single machine).
# AVORA_SECRET=change-me-to-a-long-random-string

# Seed the demo dataset (stores, menus, demo admin) on first boot.
# AVORA_DEMO=0

# Demo admin password, used when the demo dataset is seeded.
# AVORA_DEMO_PASSWORD=demo1234

# Store the database and uploads somewhere else (default: ./.data).
# AVORA_DATA_DIR=/var/lib/avora

# Add the Secure flag to session cookies. Required behind HTTPS; leave off
# for plain http://localhost.
# AVORA_SECURE_COOKIES=1

# Google sign-in on the login and register pages ("Continue with Google").
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and
# add this exact redirect URI to its "Authorized redirect URIs":
#   https://<your-domain>/api/auth/google/callback
# Leave both unset to keep the feature off — the buttons hide automatically.
# AVORA_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# AVORA_GOOGLE_CLIENT_SECRET=xxxx
